<img src='The_B.png' style ="display: block; margin: auto; width: 25%;">
<div class='item' style="text-align: center;">
	<h2>Papa Louie's Cooking Assistant</h2>
</div>
{{if !data.catalog_browse_stage}}
	<div class='item' style="text-align: center;">
		Benvenuto!
		<table align="center">
			<tr>
				<td>{{:helper.link('Browse', '', {'greet' : 1})}}</td>
			</tr>
		</table>
	</div>
{{/if}}

{{if data.catalog_browse_stage == "list"}}
	<table align="center">
		<tr>
			<td>{{:helper.link(data.catalog_search, 'search', {'catalog_search_run' : 1})}}</td>
		</tr>
	</table>
	<table style="width:100%">
		<tr><td>Preview<th style="width:30%">Name<th style="width:30%">Product<th style="width:30%">Byproduct
		{{for data.entries}}
			<tr class="candystripe">
			<td style="background-color: #1a1a1a;" align="center"><img src='{{:value.icon}}' height=50 width=50>
			<td style="background-color: #1a1a1a;" align="center">{{:helper.link(value.name, '', {'set_active_entry' : value.id})}}
			{{if value.product_is_reagent == 0}}
				<td style="background-color: #1a1a1a;" align="center">{{:value.product_count}} {{:value.product_name}}{{if value.product_count > 1}}s{{/if}}
			{{else}}
				<td style="background-color: #1a1a1a;" align="center">{{:value.product_count}}u of {{:value.product_name}}
			{{/if}}
			{{if value.byproduct_count == 0}}
				<td style="background-color: #1a1a1a;" align="center">
			{{else}}
				<td style="background-color: #1a1a1a;" align="center">{{:value.byproduct_count}}u of {{:value.byproduct_name}}
			{{/if}}
		{{/for}}
	</table>
{{/if}}

{{if data.catalog_browse_stage == "entry" || data.catalog_browse_stage == "entry_entry"}}
	{{if data.print_avaliable}}
		{{:helper.link('PRINT', '', {'print_active' : 1})}}
	{{/if}}
	{{:helper.link('BACK', '', {'go_back_entry' : 1}, null, 'floatRight')}}
	<br><br>
	<img src='{{:data.icon}}' style ="display: block; margin: auto; width: 30%;">
	<div class="item"><h1>{{:data.name}}</h1></div>
	<div class="item">{{:data.create_in}}</div>
	<div class="item">{{:data.description}}</div>
	<div class="item">
		<h4>Specifications:</h4>

		{{if data.product_is_reagent}}
			<div class="itemLabel">Reagent Name:</div>
			<div class="itemContent">{{:data.product_name}}</div>
			<div class="itemLabel">Units Produced:</div>
			<div class="itemContent">{{:data.product_count}}</div>
		{{else}}
			<div class="itemLabel">Product Name:</div>
			<div class="itemContent">{{:data.product_name}}</div>
			<div class="itemLabel">Product Count:</div>
			<div class="itemContent">{{:data.product_count}}</div>
			{{if data.byproduct_count}}
				<div class="itemLabel">Reagent Byproduct:</div>
				<div class="itemContent">{{:data.byproduct_name}}</div>
				<div class="itemLabel">Byproduct Units Produced:</div>
				<div class="itemContent">{{:data.byproduct_count}}</div>
			{{/if}}
		{{/if}}
		{{if data.recipe_guide}}
			<div class="itemLabel">Recipe:</div>
			<div class="itemContent">
					<div class="statusDisplay" style="overflow: auto;">
						{{:data.recipe_guide}}
					</div>
			</div>
		{{/if}}
	</div>
{{/if}}
